#!/bin/sh

# rootless 越狱把整棵越狱树挂在 /var/jb 下，rootful 越狱的根就是 /
JB=""
if [ -d /var/jb/usr ]; then
    JB="/var/jb"
fi

# Register app with SpringBoard
if [ -x "$JB/usr/bin/uicache" ]; then
    "$JB/usr/bin/uicache" -a
else
    su mobile -c uicache 2>/dev/null || true
fi

# sudoers.d is writable on rootless; /etc/sudoers is not
SUDOERS_D="$JB/etc/sudoers.d"
if [ -d "$SUDOERS_D" ]; then
    echo "mobile ALL=(root) NOPASSWD:$JB/usr/bin/zxtouchb" > "$SUDOERS_D/zxtouch"
    chmod 440 "$SUDOERS_D/zxtouch"
fi

# Create required app directories
mkdir -p /var/mobile/Library/ZXTouch/scripts/录制脚本/
mkdir -p /var/mobile/Library/ZXTouch/scripts/示例/
mkdir -p /var/mobile/Library/ZXTouch/config/tweak/
mkdir -p /var/mobile/Library/ZXTouch/coreutils/ScriptRuntime/
mkdir -p "$JB/usr/bin" "$JB/bin"

# Copy bundled example scripts. These are maintained by the package, so refresh
# them on upgrade while leaving unrelated user scripts alone. The old English
# "examples" folder is removed as well, otherwise an upgrade would leave two
# copies of every sample in the script list.
EXAMPLES="$JB/usr/share/zxtouch/examples"
if [ -d "$EXAMPLES" ]; then
    rm -rf /var/mobile/Library/ZXTouch/scripts/examples
    rm -rf "/var/mobile/Library/ZXTouch/scripts/示例"
    mkdir -p "/var/mobile/Library/ZXTouch/scripts/示例"
    cp -Rf "$EXAMPLES/"* "/var/mobile/Library/ZXTouch/scripts/示例/" 2>/dev/null || true
fi

REGISTRY=/var/mobile/Library/ZXTouch/config/tweak/script_registry.plist
REGISTRY_SOURCE="$JB/usr/share/zxtouch/script-registry.plist"
if [ -f "$REGISTRY_SOURCE" ]; then
    cp -f "$REGISTRY_SOURCE" "$REGISTRY"
fi

ADD_DATETIME=/var/mobile/Library/ZXTouch/coreutils/ScriptRuntime/add_datetime.sh
printf '#!%s/bin/sh\n' "$JB" > "$ADD_DATETIME"
cat >> "$ADD_DATETIME" << 'EOF'
OUTPUT=/var/mobile/Library/ZXTouch/coreutils/ScriptRuntime/output
DATE=/var/jb/usr/bin/date
if [ ! -x "$DATE" ]; then DATE=/usr/bin/date; fi
if [ ! -x "$DATE" ]; then DATE=/bin/date; fi
echo "$($DATE '+%m-%d-%Y %T'): 开始运行脚本，路径: $1" >> "$OUTPUT"
while IFS= read -r line; do
    echo "$($DATE '+%m-%d-%Y %T'): $line" >> "$OUTPUT"
done
EOF
chmod 755 "$ADD_DATETIME"
touch /var/mobile/Library/ZXTouch/coreutils/ScriptRuntime/output

chown -R mobile:mobile /var/mobile/Library/ZXTouch

# Point the jailbreak's python3 at the newest working Procursus Python we can
# find. We no longer ship a bundled Python 3.7 runtime — its libpython dylib
# lives under /usr/lib on stock iOS which doesn't exist on rootless, so it aborts
# at dyld load. Users must install python3 from Sileo (Procursus).
FOUND_PY=""
for PYBIN in \
    "$JB/usr/bin/python3.12" \
    "$JB/usr/bin/python3.11" \
    "$JB/usr/bin/python3.10" \
    "$JB/usr/bin/python3.9" \
    "$JB/usr/bin/python3.8" \
    /usr/bin/python3 \
    /bin/python3; do
    if [ -x "$PYBIN" ]; then
        [ "$PYBIN" = "$JB/usr/bin/python3" ] || ln -sf "$PYBIN" "$JB/usr/bin/python3"
        [ "$PYBIN" = "$JB/bin/python3" ] || ln -sf "$PYBIN" "$JB/bin/python3"
        FOUND_PY="$PYBIN"
        break
    fi
done
if [ -z "$FOUND_PY" ]; then
    echo "ZXTouch: warning — no working python3 found. Install one from Sileo (Procursus 'python3' package) before running .py scripts." >&2
fi

# Install zxtouch Python module into every installed Python's site/dist-packages
SRC="$JB/usr/share/zxtouch/python/zxtouch"
if [ -d "$SRC" ]; then
    for SP in "$JB"/usr/lib/python3*/site-packages "$JB"/usr/lib/python3*/dist-packages "$JB"/usr/lib/python3/dist-packages; do
        if [ -d "$SP" ]; then
            rm -rf "$SP/zxtouch"
            cp -R "$SRC" "$SP/" 2>/dev/null || true
        fi
    done
fi

# Strip expired dev provisioning profile and re-sign with ldid
APP="$JB/Applications/zxtouch.app"
rm -f "$APP/embedded.mobileprovision"
cat > /tmp/zxtouch-ent.plist << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>platform-application</key><true/>
    <key>com.apple.private.skip-library-validation</key><true/>
    <key>com.apple.private.security.no-container</key><true/>
    <key>com.apple.private.security.no-sandbox</key><true/>
    <key>com.apple.private.security.storage.AppBundles</key><true/>
    <key>com.apple.private.security.storage.AppDataContainers</key><true/>
    <key>get-task-allow</key><true/>
    <key>application-identifier</key><string>com.zjx.zxtouch</string>
</dict>
</plist>
EOF
if [ -x "$JB/usr/bin/ldid" ]; then
    "$JB/usr/bin/ldid" -S/tmp/zxtouch-ent.plist "$APP/zxtouch"
fi

# Start zxrunner daemon. Postinst runs as root, bypassing the SpringBoard exec
# restrictions. It runs as a system-domain LaunchDaemon so launchd restarts it
# after a reboot/respring (the old gui-domain LaunchAgent under /var/jb is never
# rescanned, which is why OCR later failed with "cannot connect to zxrunner").
DAEMON="$JB/usr/libexec/zxrunner"
DAEMON_PLIST="$JB/Library/LaunchDaemons/com.zjx.zxrunner.plist"
LAUNCHCTL="$JB/usr/bin/launchctl"
if [ -x "$DAEMON" ]; then
    if [ -x "$LAUNCHCTL" ]; then
        "$LAUNCHCTL" bootout system/com.zjx.zxrunner 2>/dev/null || true
        "$LAUNCHCTL" bootout gui/501/com.zjx.zxrunner 2>/dev/null || true
    fi
    rm -f "$JB/Library/LaunchAgents/com.zjx.zxrunner.plist"
    if [ -x "$JB/usr/bin/killall" ]; then
        "$JB/usr/bin/killall" zxrunner 2>/dev/null || true
    fi
    sleep 0.3
    rm -f /tmp/zxrunner.sock
    if [ -f "$DAEMON_PLIST" ] && [ -x "$LAUNCHCTL" ]; then
        "$LAUNCHCTL" bootstrap system "$DAEMON_PLIST" 2>/dev/null || true
        "$LAUNCHCTL" kickstart -k system/com.zjx.zxrunner 2>/dev/null || true
    fi
    # 服务是 launchd 起的看门狗 + 子进程服务，起来要一点时间；等够了再判断，
    # 否则会误以为没起来、再补一个 nohup 实例，两个进程抢同一个 socket。
    sleep 2
    RUNNING=0
    GREP="$JB/usr/bin/grep"
    if [ ! -x "$GREP" ]; then GREP="/usr/bin/grep"; fi
    if [ -x "$LAUNCHCTL" ] && "$LAUNCHCTL" print system/com.zjx.zxrunner 2>/dev/null | "$GREP" -q "pid = "; then
        RUNNING=1
    fi
    if [ "$RUNNING" = "0" ] && [ ! -S /tmp/zxrunner.sock ]; then
        su mobile -c "nohup $DAEMON >/dev/null 2>&1 </dev/null &" 2>/dev/null || true
        sleep 0.5
    fi
fi

# Never restart SpringBoard from a maintainer script. Package managers run this
# inside the dpkg transaction, so a restart can kill their helper before dpkg
# records the package as configured. Sileo can offer a respring after dpkg exits.
exit 0